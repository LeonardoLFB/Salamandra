<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    styleClass="page-background"
    xmlns="http://javafx.com/javafx/24.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.UsuariosController">

    <stylesheets>
        <URL value="@application.css" />
    </stylesheets>

    <children>

        <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="page-scroll"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0">

            <content>

                <VBox
                    spacing="20"
                    style="-fx-padding: 28 34 30 34;">

                    <!-- ==================================================
                         CABEÇALHO
                         ================================================== -->

                    <VBox spacing="5">

                        <Label
                            text="Usuários"
                            styleClass="page-title" />

                        <Label
                            text="Gerencie usuários e defina os níveis de acesso ao sistema."
                            styleClass="page-subtitle" />

                    </VBox>


                    <!-- ==================================================
                         CADASTRO
                         ================================================== -->

                    <VBox
                        spacing="18"
                        styleClass="form-card">

                        <VBox spacing="4">

                            <Label
                                text="NOVO USUÁRIO"
                                styleClass="form-section-title" />

                            <Label
                                text="Preencha os dados abaixo para criar um novo acesso ao Salamandra."
                                styleClass="form-section-subtitle" />

                        </VBox>


                        <!-- DADOS PESSOAIS -->

                        <VBox spacing="10">

                            <Label
                                text="Dados do usuário"
                                styleClass="field-label-strong" />

                            <GridPane
                                hgap="16"
                                vgap="8">

                                <columnConstraints>

                                    <ColumnConstraints
                                        percentWidth="55"
                                        hgrow="ALWAYS" />

                                    <ColumnConstraints
                                        percentWidth="45"
                                        hgrow="ALWAYS" />

                                </columnConstraints>


                                <Label
                                    text="Nome completo"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0" />

                                <Label
                                    text="E-mail"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0" />


                                <TextField
                                    fx:id="txtNome"
                                    promptText="Ex.: Maria da Silva"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1" />

                                <TextField
                                    fx:id="txtEmail"
                                    promptText="Ex.: maria@email.com"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1" />

                            </GridPane>

                        </VBox>


                        <!-- ACESSO -->

                        <VBox spacing="10">

                            <Label
                                text="Dados de acesso"
                                styleClass="field-label-strong" />

                            <GridPane
                                hgap="16"
                                vgap="8">

                                <columnConstraints>

                                    <ColumnConstraints
                                        percentWidth="35"
                                        hgrow="ALWAYS" />

                                    <ColumnConstraints
                                        percentWidth="35"
                                        hgrow="ALWAYS" />

                                    <ColumnConstraints
                                        percentWidth="30"
                                        hgrow="ALWAYS" />

                                </columnConstraints>


                                <Label
                                    text="Login"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0" />

                                <Label
                                    text="Senha"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0" />

                                <Label
                                    text="Nível de acesso"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0" />


                                <TextField
                                    fx:id="txtLogin"
                                    promptText="Ex.: maria.silva"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1" />

                                <PasswordField
                                    fx:id="txtSenha"
                                    promptText="Digite uma senha"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1" />

                                <ComboBox
                                    fx:id="cbTipo"
                                    promptText="Selecione"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1" />

                            </GridPane>

                        </VBox>


                        <!-- AÇÕES -->

                        <HBox
                            alignment="CENTER_RIGHT"
                            spacing="10"
                            styleClass="form-actions">

                            <Button
                                fx:id="btnCadastrar"
                                text="Cadastrar usuário"
                                styleClass="btn, btn-primary" />

                        </HBox>

                    </VBox>


                    <!-- ==================================================
                         LISTAGEM
                         ================================================== -->

                    <VBox
                        spacing="16"
                        styleClass="list-card">

                        <!-- CABEÇALHO -->

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="3">

                                <Label
                                    text="Usuários cadastrados"
                                    styleClass="form-section-title" />

                                <Label
                                    text="Consulte, edite ou remova os acessos cadastrados."
                                    styleClass="form-section-subtitle" />

                            </VBox>

                            <Region HBox.hgrow="ALWAYS" />

                        </HBox>


                        <!-- FILTROS -->

                        <HBox
                            spacing="12"
                            alignment="CENTER_LEFT">

                            <TextField
                                fx:id="txtBuscar"
                                promptText="Buscar por nome, login ou e-mail..."
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity" />

                            <ComboBox
                                fx:id="cbFiltroTipo"
                                prefWidth="210"
                                promptText="Nível de acesso" />

                        </HBox>


                        <!-- TABELA -->

                        <TableView
                            fx:id="tableUsuarios"
                            prefHeight="350"
                            VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn
                                    fx:id="colNome"
                                    text="Nome"
                                    prefWidth="240" />

                                <TableColumn
                                    fx:id="colUsuario"
                                    text="Login"
                                    prefWidth="150" />

                                <TableColumn
                                    fx:id="colEmail"
                                    text="E-mail"
                                    prefWidth="300" />

                                <TableColumn
                                    fx:id="colTipo"
                                    text="Nível de acesso"
                                    prefWidth="190" />

                                <TableColumn
                                    fx:id="colAcoes"
                                    text="Ações"
                                    prefWidth="130" />

                            </columns>

                        </TableView>


                        <!-- RODAPÉ -->

                        <HBox
                            alignment="CENTER_LEFT"
                            styleClass="user-list-footer">

                            <Label
                                text="Utilize a busca para localizar rapidamente um usuário."
                                styleClass="user-footer-text" />

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </children>

</AnchorPane>