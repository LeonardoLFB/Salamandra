<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    prefHeight="800.0"
    prefWidth="1000.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.VendaController"
    styleClass="page-background">

    <stylesheets>
        <URL value="@application.css"/>
    </stylesheets>

    <ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        styleClass="page-scroll"
        AnchorPane.topAnchor="0.0"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0">

        <content>

            <VBox
                spacing="20.0"
                styleClass="page-background">

                <padding>
                    <Insets
                        top="28.0"
                        right="34.0"
                        bottom="28.0"
                        left="34.0"/>
                </padding>

                <!-- =====================================================
                     CABEÇALHO
                     ===================================================== -->

                <VBox spacing="5.0">

                    <Label
                        text="Vendas"
                        styleClass="page-title"/>

                    <Label
                        text="Registre novas vendas e acompanhe as movimentações realizadas."
                        styleClass="page-subtitle"/>

                </VBox>

                <!-- =====================================================
                     NOVA VENDA
                     ===================================================== -->

                <VBox
                    spacing="18.0"
                    styleClass="form-card">

                    <VBox spacing="4.0">

                        <Label
                            text="NOVA VENDA"
                            styleClass="form-section-title"/>

                        <Label
                            text="Selecione o cliente e informe os dados principais da venda."
                            styleClass="form-section-subtitle"/>

                    </VBox>

                    <Separator/>

                    <!-- CLIENTE / DATA / PAGAMENTO -->

                    <GridPane
                        hgap="18.0"
                        vgap="16.0">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0"/>
                            <ColumnConstraints percentWidth="20.0"/>
                            <ColumnConstraints percentWidth="30.0"/>
                        </columnConstraints>

                        <!-- CLIENTE -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0">

                            <Label
                                text="Cliente *"
                                styleClass="field-label-strong"/>

                            <ComboBox
                                fx:id="comboCliente"
                                editable="true"
                                maxWidth="Infinity"
                                promptText="Digite ou selecione o cliente"/>

                        </VBox>

                        <!-- DATA -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0">

                            <Label
                                text="Data *"
                                styleClass="field-label-strong"/>

                            <DatePicker
                                fx:id="datePickerVenda"
                                maxWidth="Infinity"/>

                        </VBox>

                        <!-- PAGAMENTO -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0">

                            <Label
                                text="Forma de pagamento"
                                styleClass="field-label-strong"/>

                            <ComboBox
                                fx:id="comboPagamento"
                                maxWidth="Infinity"
                                promptText="Selecione"/>

                        </VBox>

                    </GridPane>

                    <!-- =================================================
                         ADICIONAR PRODUTO
                         ================================================= -->

                    <VBox spacing="4.0">

                        <Label
                            text="ADICIONAR PRODUTO"
                            styleClass="form-section-title"/>

                        <Label
                            text="Selecione um produto, informe a quantidade e adicione-o à venda."
                            styleClass="form-section-subtitle"/>

                    </VBox>

                    <Separator/>

                    <GridPane
                        hgap="18.0"
                        vgap="16.0">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="45.0"/>
                            <ColumnConstraints percentWidth="17.0"/>
                            <ColumnConstraints percentWidth="20.0"/>
                            <ColumnConstraints percentWidth="18.0"/>
                        </columnConstraints>

                        <!-- PRODUTO -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0">

                            <Label
                                text="Produto *"
                                styleClass="field-label-strong"/>

                            <ComboBox
                                fx:id="comboProduto"
                                editable="true"
                                maxWidth="Infinity"
                                promptText="Digite ou selecione o produto"/>

                        </VBox>

                        <!-- QUANTIDADE -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0">

                            <Label
                                text="Quantidade *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="txtQuantidade"
                                promptText="Ex.: 2"/>

                        </VBox>

                        <!-- PREÇO -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0">

                            <Label
                                text="Preço unitário"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="txtPrecoUnitario"
                                promptText="R$ 0,00"/>

                        </VBox>

                        <!-- ADICIONAR -->

                        <VBox
                            alignment="BOTTOM_CENTER"
                            spacing="6.0"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0">

                            <Button
                                fx:id="btnAdicionarItem"
                                text="+ Adicionar item"
                                maxWidth="Infinity"
                                onAction="#onAdicionarItem"
                                styleClass="btn, btn-success"/>

                        </VBox>

                    </GridPane>

                    <!-- =================================================
                         ITENS DA VENDA
                         ================================================= -->

                    <VBox spacing="10.0">

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="3.0">

                                <Label
                                    text="Itens da venda"
                                    styleClass="dashboard-section-title"/>

                                <Label
                                    text="Produtos adicionados à venda atual."
                                    styleClass="form-section-subtitle"/>

                            </VBox>

                        </HBox>

                        <TableView
                            fx:id="tableItens"
                            prefHeight="210.0"
                            minHeight="180.0">

                            <columns>

                                <TableColumn
                                    fx:id="colItemProduto"
                                    prefWidth="300.0"
                                    text="PRODUTO"/>

                                <TableColumn
                                    fx:id="colItemQuantidade"
                                    prefWidth="130.0"
                                    text="QUANTIDADE"/>

                                <TableColumn
                                    fx:id="colItemPreco"
                                    prefWidth="150.0"
                                    text="PREÇO UNIT."/>

                                <TableColumn
                                    fx:id="colItemSubtotal"
                                    prefWidth="160.0"
                                    text="SUBTOTAL"/>

                                <TableColumn
                                    fx:id="colItemAcoes"
                                    prefWidth="110.0"
                                    text="AÇÕES"/>

                            </columns>

                        </TableView>

                    </VBox>

                    <!-- =================================================
                         TOTAL
                         ================================================= -->

                    <HBox alignment="CENTER_RIGHT">

                        <VBox
                            alignment="CENTER_RIGHT"
                            spacing="3.0"
                            styleClass="sale-total-box">

                            <Label
                                text="TOTAL DA VENDA"
                                styleClass="sale-total-label"/>

                            <Label
                                fx:id="lblValorTotal"
                                text="Valor Total: R$ 0,00"
                                styleClass="sale-total-value"/>

                        </VBox>

                    </HBox>

                    <!-- =================================================
                         AÇÕES
                         ================================================= -->

                    <HBox
                        alignment="CENTER_RIGHT"
                        spacing="12.0"
                        styleClass="form-actions">

                        <Button
                            fx:id="btnLimpar"
                            text="Limpar venda"
                            onAction="#onLimpar"
                            styleClass="btn, btn-secondary"/>

                        <Button
                            fx:id="btnFinalizarVenda"
                            text="Finalizar venda"
                            onAction="#onFinalizarVenda"
                            styleClass="btn, btn-primary"/>

                    </HBox>

                </VBox>

                <!-- =====================================================
                     HISTÓRICO DE VENDAS
                     ===================================================== -->

                <VBox
                    spacing="14.0"
                    styleClass="list-card">

                    <VBox spacing="3.0">

                        <Label
                            text="Histórico de vendas"
                            styleClass="dashboard-section-title"/>

                        <Label
                            text="Consulte as vendas registradas e acompanhe seus status."
                            styleClass="form-section-subtitle"/>

                    </VBox>

                    <!-- BUSCA -->

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="12.0">

                        <HBox
                            alignment="CENTER_LEFT"
                            spacing="8.0"
                            styleClass="search-bar"
                            HBox.hgrow="ALWAYS">

                            <Label text="🔍"/>

                            <TextField
                                fx:id="txtBusca"
                                promptText="Buscar por cliente ou ID..."
                                onKeyReleased="#onBuscar"
                                HBox.hgrow="ALWAYS"/>

                        </HBox>

                        <ComboBox
                            fx:id="comboFiltroStatus"
                            prefWidth="180.0"
                            promptText="Status"
                            onAction="#onFiltrarStatus"/>

                    </HBox>

                    <!-- TABELA -->

                    <TableView
                        fx:id="tableVendas"
                        prefHeight="320.0"
                        minHeight="280.0">

                        <columns>

                            <TableColumn
                                fx:id="colId"
                                prefWidth="70.0"
                                text="ID"/>

                            <TableColumn
                                fx:id="colCliente"
                                prefWidth="190.0"
                                text="CLIENTE"/>

                            <TableColumn
                                fx:id="colResponsavel"
                                prefWidth="170.0"
                                text="RESPONSÁVEL"/>

                            <TableColumn
                                fx:id="colData"
                                prefWidth="155.0"
                                text="DATA"/>

                            <TableColumn
                                fx:id="colValor"
                                prefWidth="140.0"
                                text="VALOR TOTAL"/>

                            <TableColumn
                                fx:id="colStatus"
                                prefWidth="125.0"
                                text="STATUS"/>

                            <TableColumn
                                fx:id="colAcoes"
                                prefWidth="330.0"
                                text="AÇÕES"/>

                        </columns>

                    </TableView>

                </VBox>

            </VBox>

        </content>

    </ScrollPane>

</AnchorPane>