<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<AnchorPane
    prefHeight="600"
    prefWidth="900"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.LoginController">

    <stylesheets>
        <URL value="@application.css" />
    </stylesheets>

    <children>

        <HBox
            spacing="0"
            AnchorPane.topAnchor="10"
            AnchorPane.bottomAnchor="10"
            AnchorPane.leftAnchor="10"
            AnchorPane.rightAnchor="10">

            <!-- ==================================================
                 LADO ESQUERDO
                 ================================================== -->

            <AnchorPane
                prefWidth="540"
                styleClass="painel-imagem-login"
                HBox.hgrow="ALWAYS" />

            <!-- ==================================================
                 LADO DIREITO
                 ================================================== -->

            <AnchorPane
                prefHeight="570"
                prefWidth="537"
                styleClass="login-panel"
                HBox.hgrow="ALWAYS">

                <children>

                    <VBox
                        alignment="CENTER"
                        spacing="20"
                        AnchorPane.topAnchor="32"
                        AnchorPane.bottomAnchor="32"
                        AnchorPane.leftAnchor="45"
                        AnchorPane.rightAnchor="45">

                        <!-- LOGO -->

                        <ImageView
                            fitHeight="150"
                            fitWidth="190"
                            preserveRatio="true">

                            <image>
                                <Image url="@../img/LogoBranco.png" />
                            </image>

                        </ImageView>

                        <!-- TÍTULO -->

                        <VBox
                            alignment="CENTER"
                            spacing="4">

                            <Label
                                styleClass="login-title"
                                text="Acesse sua conta" />

                            <Label
                                styleClass="login-subtitle"
                                text="Entre com suas credenciais para continuar" />

                        </VBox>

                        <!-- FORMULÁRIO -->

                        <VBox
                            maxWidth="420"
                            minWidth="300"
                            spacing="13">

                            <!-- LOGIN -->

                            <VBox spacing="5">

                                <Label
                                    styleClass="login-field-label"
                                    text="Usuário" />

                                <TextField
                                    fx:id="tfLogin"
                                    prefHeight="44"
                                    promptText="Digite seu usuário"
                                    styleClass="login-field" />

                            </VBox>

                            <!-- SENHA -->

                            <VBox spacing="5">

                                <Label
                                    styleClass="login-field-label"
                                    text="Senha" />

                                <StackPane>

                                    <PasswordField
                                        fx:id="pfSenha"
                                        prefHeight="44"
                                        promptText="Digite sua senha"
                                        styleClass="login-field"
                                        StackPane.alignment="CENTER" />

                                    <TextField
                                        fx:id="tfSenhaVisivel"
                                        prefHeight="44"
                                        promptText="Digite sua senha"
                                        styleClass="login-field"
                                        visible="false"
                                        managed="false"
                                        StackPane.alignment="CENTER" />

                                    <HBox
                                        alignment="CENTER_RIGHT"
                                        mouseTransparent="false"
                                        StackPane.alignment="CENTER_RIGHT">

                                        <Region HBox.hgrow="ALWAYS" />

                                        <Button
                                            fx:id="btMostrarSenha"
                                            text="👁"
                                            focusTraversable="false"
                                            styleClass="login-eye-button" />

                                    </HBox>

                                </StackPane>

                            </VBox>

                            <!-- OPÇÕES -->

                            <HBox alignment="CENTER_LEFT">

                                <CheckBox
                                    fx:id="cbLembrarLogin"
                                    text="Lembrar meu usuário"
                                    styleClass="login-checkbox" />

                                <Region HBox.hgrow="ALWAYS" />

                            </HBox>

                            <!-- MENSAGEM -->

                            <Label
    fx:id="lblMensagem"
    visible="false"
    managed="false"
    wrapText="true"
    maxWidth="420"
    prefWidth="420"
    styleClass="login-message" />

                            <!-- BOTÕES -->

                            <HBox
                                alignment="CENTER"
                                spacing="12">

                                <padding>
                                    <Insets top="6" />
                                </padding>

                                <Button
                                    fx:id="btLogar"
                                    defaultButton="true"
                                    onAction="#onClickLogar"
                                    prefHeight="44"
                                    maxWidth="Infinity"
                                    styleClass="login-primary-button"
                                    text="Entrar"
                                    HBox.hgrow="ALWAYS" />

                                <Button
                                    fx:id="btCancelar"
                                    onAction="#onClickCancelar"
                                    prefHeight="44"
                                    prefWidth="110"
                                    styleClass="login-secondary-button"
                                    text="Cancelar" />

                            </HBox>

                        </VBox>

                    </VBox>

                </children>

            </AnchorPane>

        </HBox>

    </children>

</AnchorPane>