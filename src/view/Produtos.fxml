<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane
    prefWidth="900.0"
    prefHeight="600.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.ProdutosController"
    styleClass="page-background">

    <stylesheets>
        <URL value="@application.css" />
    </stylesheets>

    <VBox
        spacing="22.0"
        AnchorPane.topAnchor="0.0"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0">

        <padding>
            <Insets top="28.0" right="34.0" bottom="28.0" left="34.0"/>
        </padding>

        <!-- ================= CABEÇALHO ================= -->

        <VBox spacing="5.0">
            <Label
                text="Cadastro de Produtos"
                styleClass="page-title"/>

            <Label
                text="Cadastre um novo produto e defina suas informações de venda e estoque."
                styleClass="page-subtitle"/>
        </VBox>

        <!-- ================= CARD PRINCIPAL ================= -->

        <VBox
            spacing="20.0"
            styleClass="form-card">

            <!-- INFORMAÇÕES BÁSICAS -->

            <VBox spacing="4.0">
                <Label
                    text="INFORMAÇÕES DO PRODUTO"
                    styleClass="form-section-title"/>

                <Label
                    text="Preencha os dados de identificação do produto."
                    styleClass="form-section-subtitle"/>
            </VBox>

            <Separator/>

            <GridPane
                hgap="18.0"
                vgap="16.0">

                <columnConstraints>
                    <ColumnConstraints percentWidth="70.0"/>
                    <ColumnConstraints percentWidth="30.0"/>
                </columnConstraints>

                <!-- NOME -->

                <VBox
                    spacing="6.0"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0">

                    <Label
                        text="Nome do produto *"
                        styleClass="field-label-strong"/>

                    <TextField
                        fx:id="txtNome"
                        promptText="Ex.: Incenso de Sândalo"/>
                </VBox>

                <!-- CÓDIGO -->

                <VBox
                    spacing="6.0"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0">

                    <Label
                        text="Código *"
                        styleClass="field-label-strong"/>

                    <TextField
                        fx:id="txtCodigo"
                        promptText="Ex.: 1001"/>
                </VBox>

                <!-- DESCRIÇÃO -->

                <VBox
                    spacing="6.0"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1">

                    <Label
                        text="Descrição"
                        styleClass="field-label-strong"/>

                    <TextField
                        fx:id="txtDescricao"
                        promptText="Descrição ou características do produto"/>
                </VBox>

                <!-- LOTE -->

                <VBox
                    spacing="6.0"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1">

                    <Label
                        text="Lote *"
                        styleClass="field-label-strong"/>

                    <TextField
                        fx:id="txtLote"
                        promptText="Máx. 5 caracteres"/>
                </VBox>

            </GridPane>

            <!-- ================= VALORES ================= -->

            <VBox spacing="4.0">
                <Label
                    text="VALORES E ESTOQUE"
                    styleClass="form-section-title"/>

                <Label
                    text="Informe os valores comerciais e a quantidade inicial disponível."
                    styleClass="form-section-subtitle"/>
            </VBox>

            <Separator/>

            <GridPane
                hgap="18.0"
                vgap="16.0">

                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.34"/>
                </columnConstraints>

                <!-- PREÇO DE CUSTO -->

                <VBox
                    spacing="6.0"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0">

                    <Label
                        text="Preço de custo *"
                        styleClass="field-label-strong"/>

                    <TextField
                        fx:id="txtPrecoCusto"
                        promptText="R$ 0,00"/>
                </VBox>

                <!-- PREÇO DE VENDA -->

                <VBox
                    spacing="6.0"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0">

                    <Label
                        text="Preço de venda *"
                        styleClass="field-label-strong"/>

                    <TextField
                        fx:id="txtPrecoVenda"
                        promptText="R$ 0,00"/>
                </VBox>

                <!-- ESTOQUE -->

                <VBox
                    spacing="6.0"
                    GridPane.columnIndex="2"
                    GridPane.rowIndex="0">

                    <Label
                        text="Estoque inicial *"
                        styleClass="field-label-strong"/>

                    <TextField
                        fx:id="txtQuantidadeEstoque"
                        promptText="Ex.: 30"/>
                </VBox>

            </GridPane>

        </VBox>

        <!-- Empurra as ações para baixo quando houver espaço -->

        <Region VBox.vgrow="ALWAYS"/>

        <!-- ================= AÇÕES ================= -->

        <HBox
            alignment="CENTER_RIGHT"
            spacing="12.0"
            styleClass="form-actions">

            <Button
                fx:id="btnCancelar"
                text="Limpar"
                onAction="#cancelar"
                styleClass="btn, btn-secondary"/>

            <Button
                fx:id="btnSalvar"
                text="Cadastrar produto"
                onAction="#cadastrarProduto"
                styleClass="btn, btn-primary"/>

        </HBox>

    </VBox>

</AnchorPane>