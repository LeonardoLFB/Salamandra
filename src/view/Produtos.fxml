<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefWidth="900" prefHeight="600"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ProdutosController"
            style="-fx-background-color: #F3F4F6;">

    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <!-- TÍTULO -->
        <VBox spacing="4">
            <Label text="Cadastro de Produtos"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;" />
            <Label text="Insira as informações do novo produto."
                   style="-fx-text-fill: #6B7280; -fx-font-size: 14px;" />
        </VBox>

        <!-- CAMPOS DO FORMULÁRIO -->
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10;">

            <!-- NOME -->
            <VBox spacing="5">
                <Label text="Nome" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <TextField fx:id="txtNome" promptText="Digite o nome do produto" />
            </VBox>

            <!-- CÓDIGO -->
            <VBox spacing="5">
                <Label text="Código" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <TextField fx:id="txtCodigo" promptText="Digite o código do produto (Somente numeros)" />
            </VBox>

            <!-- LOTE -->
            <VBox spacing="5">
                <Label text="Lote" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <TextField fx:id="txtLote" promptText="Digite o lote (MAX 5 CARACTERES)" />
            </VBox>

            <!-- DESCRIÇÃO -->
            <VBox spacing="5">
                <Label text="Descrição" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <TextField fx:id="txtDescricao" promptText="Descreva o produto" />
            </VBox>

            <!-- PREÇO DE CUSTO -->
            <VBox spacing="5">
                <Label text="Preço de Custo" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <TextField fx:id="txtPrecoCusto" promptText="Ex.: 12.50" />
            </VBox>
            <!-- PREÇO DE VENDA -->
            <VBox spacing="6">
                <Label text="Preço de Venda" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <TextField fx:id="txtPrecoVenda" promptText="Ex.: 29.90" />
            </VBox>

            <!-- QUANTIDADE EM ESTOQUE -->
            <VBox spacing="5">
                <Label text="Quantidade em Estoque" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <TextField fx:id="txtQuantidadeEstoque" promptText="Ex.: 30" />
            </VBox>
        </VBox>

        <!-- BOTÕES -->
        <HBox spacing="15">
            <Button fx:id="btnSalvar"
                    text="Salvar"
                    onAction="#cadastrarProduto"
                    style="-fx-background-color: #10B981; -fx-text-fill: white;
                           -fx-padding: 10 20; -fx-background-radius: 8;" />

            <Button fx:id="btnCancelar"
                    text="Cancelar"
                    onAction="#cancelar"
                    style="-fx-background-color: #EF4444; -fx-text-fill: white;
                           -fx-padding: 10 20; -fx-background-radius: 8;" />
        </HBox>

    </VBox>

</AnchorPane>
