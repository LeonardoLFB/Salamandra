<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane
    prefHeight="680.0"
    prefWidth="900.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.ClienteController"
    styleClass="page-background">

    <stylesheets>
        <URL value="@application.css"/>
    </stylesheets>

    <ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        styleClass="page-scroll"
        AnchorPane.topAnchor="0.0"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0">

        <content>

            <VBox
                spacing="20.0"
                styleClass="page-background">

                <padding>
                    <Insets
                        top="28.0"
                        right="34.0"
                        bottom="28.0"
                        left="34.0"/>
                </padding>

                <!-- =====================================================
                     CABEÇALHO
                     ===================================================== -->

                <VBox spacing="5.0">

                    <Label
                        text="Clientes"
                        styleClass="page-title"/>

                    <Label
                        text="Cadastre, gerencie e consulte os clientes da sua loja."
                        styleClass="page-subtitle"/>

                </VBox>

                <!-- =====================================================
                     CARD DE CADASTRO
                     ===================================================== -->

                <VBox
                    spacing="18.0"
                    styleClass="form-card">

                    <!-- DADOS DO CLIENTE -->

                    <VBox spacing="4.0">

                        <Label
                            text="DADOS DO CLIENTE"
                            styleClass="form-section-title"/>

                        <Label
                            text="Informe os dados principais de identificação e contato."
                            styleClass="form-section-subtitle"/>

                    </VBox>

                    <Separator/>

                    <GridPane
                        hgap="18.0"
                        vgap="16.0">

                        <columnConstraints>

                            <ColumnConstraints percentWidth="50.0"/>

                            <ColumnConstraints percentWidth="25.0"/>

                            <ColumnConstraints percentWidth="25.0"/>

                        </columnConstraints>

                        <!-- NOME -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0">

                            <Label
                                text="Nome completo *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfNome"
                                promptText="Ex.: João da Silva"/>

                        </VBox>

                        <!-- CPF -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0">

                            <Label
                                text="CPF *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfCpf"
                                promptText="000.000.000-00"/>

                        </VBox>

                        <!-- EMAIL -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0">

                            <Label
                                text="E-mail *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfEmail"
                                promptText="email@exemplo.com"/>

                        </VBox>

                    </GridPane>

                    <!-- =====================================================
                         ENDEREÇO
                         ===================================================== -->

                    <VBox spacing="4.0">

                        <Label
                            text="ENDEREÇO"
                            styleClass="form-section-title"/>

                        <Label
                            text="Informe o endereço principal do cliente."
                            styleClass="form-section-subtitle"/>

                    </VBox>

                    <Separator/>

                    <GridPane
                        hgap="18.0"
                        vgap="16.0">

                        <columnConstraints>

                            <ColumnConstraints percentWidth="50.0"/>

                            <ColumnConstraints percentWidth="15.0"/>

                            <ColumnConstraints percentWidth="35.0"/>

                        </columnConstraints>

                        <!-- RUA -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0">

                            <Label
                                text="Rua *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfRua"
                                promptText="Ex.: Rua das Flores"/>

                        </VBox>

                        <!-- NÚMERO -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0">

                            <Label
                                text="Número *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfNumero"
                                promptText="123"/>

                        </VBox>

                        <!-- BAIRRO -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0">

                            <Label
                                text="Bairro *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfBairro"
                                promptText="Ex.: Centro"/>

                        </VBox>

                    </GridPane>

                    <!-- LINHA CIDADE / UF / CEP -->

                    <GridPane
                        hgap="18.0"
                        vgap="16.0">

                        <columnConstraints>

                            <ColumnConstraints percentWidth="55.0"/>

                            <ColumnConstraints percentWidth="20.0"/>

                            <ColumnConstraints percentWidth="25.0"/>

                        </columnConstraints>

                        <!-- CIDADE -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0">

                            <Label
                                text="Cidade *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfCidade"
                                promptText="Ex.: Indaiatuba"/>

                        </VBox>

                        <!-- ESTADO -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0">

                            <Label
                                text="Estado (UF) *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfEstado"
                                promptText="SP"/>

                        </VBox>

                        <!-- CEP -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0">

                            <Label
                                text="CEP *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfCep"
                                promptText="00000-000"/>

                        </VBox>

                    </GridPane>

                    <!-- =====================================================
                         AÇÕES DO FORMULÁRIO
                         ===================================================== -->

                    <HBox
                        alignment="CENTER_RIGHT"
                        spacing="12.0">

                        <Button
                            fx:id="btnLimpar"
                            text="Limpar"
                            onAction="#onLimparFormulario"
                            styleClass="btn, btn-secondary"/>

                        <Button
                            fx:id="btnCadastrar"
                            text="Cadastrar cliente"
                            onAction="#onCadastrarCliente"
                            styleClass="btn, btn-primary"/>

                    </HBox>

                </VBox>

                <!-- =====================================================
                     CLIENTES CADASTRADOS
                     ===================================================== -->

                <VBox
                    spacing="12.0"
                    styleClass="list-card">

                    <!-- CABEÇALHO -->

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="12.0">

                        <VBox spacing="2.0">

                            <Label
                                text="Clientes cadastrados"
                                styleClass="dashboard-section-title"/>

                            <Label
                                text="Consulte, edite ou exclua clientes cadastrados."
                                styleClass="form-section-subtitle"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button
                            fx:id="btnAtualizar"
                            text="Atualizar"
                            onAction="#onAtualizar"
                            styleClass="btn, btn-secondary"/>

                    </HBox>

                    <!-- =====================================================
                         BUSCA
                         ===================================================== -->

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="8.0"
                        styleClass="search-bar">

                        <Label text="🔍"/>

                        <TextField
                            fx:id="tfBusca"
                            promptText="Buscar por nome, CPF ou e-mail..."
                            HBox.hgrow="ALWAYS"/>

                    </HBox>

                    <!-- =====================================================
                         TABELA
                         ===================================================== -->

                    <TableView
                        fx:id="tableClientes"
                        prefHeight="320.0"
                        minHeight="280.0">

                        <columns>

                            <TableColumn
                                fx:id="colId"
                                prefWidth="65.0"
                                text="ID"/>

                            <TableColumn
                                fx:id="colNome"
                                prefWidth="220.0"
                                text="NOME"/>

                            <TableColumn
                                fx:id="colCpf"
                                prefWidth="140.0"
                                text="CPF"/>

                            <TableColumn
                                fx:id="colEmail"
                                prefWidth="210.0"
                                text="E-MAIL"/>

                            <TableColumn
                                fx:id="colEndereco"
                                prefWidth="300.0"
                                text="ENDEREÇO"/>

                            <TableColumn
                                fx:id="colAcoes"
                                prefWidth="90.0"
                                text="AÇÕES"/>

                        </columns>

                    </TableView>

                </VBox>

            </VBox>

        </content>

    </ScrollPane>

</AnchorPane>