<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.RelatoriosController"
    prefWidth="1000.0"
    prefHeight="650.0"
    stylesheets="@application.css">

    <children>

        <VBox
            spacing="18.0"
            AnchorPane.topAnchor="20.0"
            AnchorPane.leftAnchor="20.0"
            AnchorPane.rightAnchor="20.0"
            AnchorPane.bottomAnchor="20.0">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label
                text="Relatórios"
                styleClass="titulo-pagina"/>

            <HBox spacing="15.0">

                <VBox spacing="5.0">

                    <Label text="Data inicial"/>

                    <DatePicker
                        fx:id="dpDataInicial"
                        prefWidth="180.0"/>

                </VBox>

                <VBox spacing="5.0">

                    <Label text="Data final"/>

                    <DatePicker
                        fx:id="dpDataFinal"
                        prefWidth="180.0"/>

                </VBox>

                <VBox alignment="BOTTOM_LEFT">

                    <Button
                        fx:id="btnBuscar"
                        text="Buscar"
                        onAction="#buscarRelatorios"
                        prefWidth="120.0"
                        styleClass="botao-principal"/>

                </VBox>

            </HBox>

            <TabPane
                tabClosingPolicy="UNAVAILABLE"
                VBox.vgrow="ALWAYS">

                <tabs>

                    <!-- ==================================================
                         VENDAS POR PERÍODO
                         ================================================== -->

                    <Tab text="Vendas por período">

                        <VBox spacing="18.0">

                            <padding>
                                <Insets
                                    top="20"
                                    right="15"
                                    bottom="15"
                                    left="15"/>
                            </padding>

                            <Label
                                text="Vendas por período"
                                styleClass="subtitulo-pagina"/>

                            <HBox spacing="20.0">

                                <VBox
                                    spacing="5.0"
                                    prefWidth="220.0"
                                    styleClass="card-dashboard">

                                    <padding>
                                        <Insets
                                            top="15"
                                            right="15"
                                            bottom="15"
                                            left="15"/>
                                    </padding>

                                    <Label
                                        text="Quantidade de vendas"
                                        styleClass="card-titulo"/>

                                    <Label
                                        fx:id="lblQuantidadeVendas"
                                        text="0"
                                        styleClass="card-valor"/>

                                </VBox>

                                <VBox
                                    spacing="5.0"
                                    prefWidth="220.0"
                                    styleClass="card-dashboard">

                                    <padding>
                                        <Insets
                                            top="15"
                                            right="15"
                                            bottom="15"
                                            left="15"/>
                                    </padding>

                                    <Label
                                        text="Faturamento"
                                        styleClass="card-titulo"/>

                                    <Label
                                        fx:id="lblFaturamento"
                                        text="R$ 0,00"
                                        styleClass="card-valor"/>

                                </VBox>

                            </HBox>

                            <TableView
                                fx:id="tabelaVendas"
                                VBox.vgrow="ALWAYS">

                                <columns>

                                    <TableColumn
                                        fx:id="colId"
                                        text="ID"
                                        prefWidth="70.0"/>

                                    <TableColumn
                                        fx:id="colData"
                                        text="Data"
                                        prefWidth="170.0"/>

                                    <TableColumn
                                        fx:id="colCliente"
                                        text="Cliente"
                                        prefWidth="280.0"/>

                                    <TableColumn
                                        fx:id="colValor"
                                        text="Valor"
                                        prefWidth="160.0"/>

                                    <TableColumn
                                        fx:id="colStatus"
                                        text="Status"
                                        prefWidth="160.0"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </Tab>

                    <!-- ==================================================
                         PRODUTOS MAIS VENDIDOS
                         ================================================== -->

                    <Tab text="Produtos mais vendidos">

                        <VBox spacing="18.0">

                            <padding>
                                <Insets
                                    top="20"
                                    right="15"
                                    bottom="15"
                                    left="15"/>
                            </padding>

                            <Label
                                text="Produtos mais vendidos"
                                styleClass="subtitulo-pagina"/>

                            <Label
                                text="Ranking dos produtos vendidos no período selecionado."/>

                            <TableView
                                fx:id="tabelaProdutosMaisVendidos"
                                VBox.vgrow="ALWAYS">

                                <columns>

                                    <TableColumn
                                        fx:id="colProdutoId"
                                        text="ID"
                                        prefWidth="80.0"/>

                                    <TableColumn
                                        fx:id="colProdutoNome"
                                        text="Produto"
                                        prefWidth="400.0"/>

                                    <TableColumn
                                        fx:id="colQuantidadeVendida"
                                        text="Quantidade vendida"
                                        prefWidth="200.0"/>

                                    <TableColumn
                                        fx:id="colProdutoValorTotal"
                                        text="Valor total"
                                        prefWidth="200.0"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </Tab>

                    <!-- ==================================================
                         FATURAMENTO
                         ================================================== -->

                    <Tab text="Faturamento">

                        <VBox spacing="22.0">

                            <padding>
                                <Insets
                                    top="20"
                                    right="15"
                                    bottom="15"
                                    left="15"/>
                            </padding>

                            <Label
                                text="Faturamento por período"
                                styleClass="subtitulo-pagina"/>

                            <Label
                                text="Resumo financeiro das vendas concluídas no período selecionado."/>

                            <HBox spacing="20.0">

                                <VBox
                                    spacing="8.0"
                                    prefWidth="260.0"
                                    styleClass="card-dashboard">

                                    <padding>
                                        <Insets
                                            top="20"
                                            right="20"
                                            bottom="20"
                                            left="20"/>
                                    </padding>

                                    <Label
                                        text="Faturamento total"
                                        styleClass="card-titulo"/>

                                    <Label
                                        fx:id="lblFaturamentoPeriodo"
                                        text="R$ 0,00"
                                        styleClass="card-valor"/>

                                </VBox>

                                <VBox
                                    spacing="8.0"
                                    prefWidth="260.0"
                                    styleClass="card-dashboard">

                                    <padding>
                                        <Insets
                                            top="20"
                                            right="20"
                                            bottom="20"
                                            left="20"/>
                                    </padding>

                                    <Label
                                        text="Vendas concluídas"
                                        styleClass="card-titulo"/>

                                    <Label
                                        fx:id="lblVendasConcluidas"
                                        text="0"
                                        styleClass="card-valor"/>

                                </VBox>

                                <VBox
                                    spacing="8.0"
                                    prefWidth="260.0"
                                    styleClass="card-dashboard">

                                    <padding>
                                        <Insets
                                            top="20"
                                            right="20"
                                            bottom="20"
                                            left="20"/>
                                    </padding>

                                    <Label
                                        text="Ticket médio"
                                        styleClass="card-titulo"/>

                                    <Label
                                        fx:id="lblTicketMedio"
                                        text="R$ 0,00"
                                        styleClass="card-valor"/>

                                </VBox>

                            </HBox>

                        </VBox>

                    </Tab>

                    <!-- ==================================================
                         ESTOQUE BAIXO
                         ================================================== -->

                    <Tab text="Estoque baixo">

                        <VBox spacing="18.0">

                            <padding>
                                <Insets
                                    top="20"
                                    right="15"
                                    bottom="15"
                                    left="15"/>
                            </padding>

                            <Label
                                text="Estoque baixo"
                                styleClass="subtitulo-pagina"/>

                            <Label
                                text="Produtos com 10 unidades ou menos em estoque."/>

                            <HBox spacing="20.0">

                                <VBox
                                    spacing="8.0"
                                    prefWidth="240.0"
                                    styleClass="card-dashboard">

                                    <padding>
                                        <Insets
                                            top="15"
                                            right="15"
                                            bottom="15"
                                            left="15"/>
                                    </padding>

                                    <Label
                                        text="Produtos com estoque baixo"
                                        styleClass="card-titulo"/>

                                    <Label
                                        fx:id="lblProdutosEstoqueBaixo"
                                        text="0"
                                        styleClass="card-valor"/>

                                </VBox>

                                <VBox
                                    spacing="8.0"
                                    prefWidth="240.0"
                                    styleClass="card-dashboard">

                                    <padding>
                                        <Insets
                                            top="15"
                                            right="15"
                                            bottom="15"
                                            left="15"/>
                                    </padding>

                                    <Label
                                        text="Produtos sem estoque"
                                        styleClass="card-titulo"/>

                                    <Label
                                        fx:id="lblProdutosSemEstoque"
                                        text="0"
                                        styleClass="card-valor"/>

                                </VBox>

                            </HBox>

                            <TableView
                                fx:id="tabelaEstoqueBaixo"
                                VBox.vgrow="ALWAYS">

                                <columns>

                                    <TableColumn
                                        fx:id="colEstoqueId"
                                        text="ID"
                                        prefWidth="90.0"/>

                                    <TableColumn
                                        fx:id="colEstoqueProduto"
                                        text="Produto"
                                        prefWidth="430.0"/>

                                    <TableColumn
                                        fx:id="colEstoqueQuantidade"
                                        text="Quantidade"
                                        prefWidth="180.0"/>

                                    <TableColumn
                                        fx:id="colEstoqueSituacao"
                                        text="Situação"
                                        prefWidth="200.0"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </Tab>

                    <!-- ==================================================
                         CLIENTES QUE MAIS COMPRARAM
                         ================================================== -->

                    <Tab text="Clientes que mais compraram">

                        <VBox spacing="18.0">

                            <padding>
                                <Insets
                                    top="20"
                                    right="15"
                                    bottom="15"
                                    left="15"/>
                            </padding>

                            <Label
                                text="Clientes que mais compraram"
                                styleClass="subtitulo-pagina"/>

                            <Label
                                text="Ranking dos clientes com maior valor em compras concluídas no período selecionado."/>

                            <TableView
                                fx:id="tabelaClientesMaisCompraram"
                                VBox.vgrow="ALWAYS">

                                <columns>

                                    <TableColumn
                                        fx:id="colClienteId"
                                        text="ID"
                                        prefWidth="90.0"/>

                                    <TableColumn
                                        fx:id="colClienteNome"
                                        text="Cliente"
                                        prefWidth="420.0"/>

                                    <TableColumn
                                        fx:id="colClienteQuantidadeCompras"
                                        text="Quantidade de compras"
                                        prefWidth="220.0"/>

                                    <TableColumn
                                        fx:id="colClienteValorTotal"
                                        text="Total gasto"
                                        prefWidth="220.0"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </Tab>

                </tabs>

            </TabPane>

        </VBox>

    </children>

</AnchorPane>