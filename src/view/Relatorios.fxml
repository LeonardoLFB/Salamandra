<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.RelatoriosController"
    prefWidth="1000.0"
    prefHeight="650.0"
    styleClass="page-background"
    stylesheets="@application.css">

    <children>

        <VBox
            spacing="18.0"
            AnchorPane.topAnchor="20.0"
            AnchorPane.leftAnchor="20.0"
            AnchorPane.rightAnchor="20.0"
            AnchorPane.bottomAnchor="20.0">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- ==================================================
                 CABEÇALHO
                 ================================================== -->

            <VBox spacing="2.0">

                <Label
                    text="Relatórios"
                    styleClass="page-title"/>

                <Label
                    text="Acompanhe vendas, faturamento, estoque e o desempenho dos seus clientes."
                    styleClass="page-subtitle"/>

            </VBox>

            <!-- ==================================================
                 FILTRO DE PERÍODO
                 ================================================== -->

            <HBox
                spacing="20.0"
                alignment="CENTER_LEFT"
                styleClass="reports-filter-bar">

                <VBox spacing="5.0">

                    <Label text="Data inicial" styleClass="field-label"/>

                    <DatePicker
                        fx:id="dpDataInicial"
                        prefWidth="180.0"/>

                </VBox>

                <VBox spacing="5.0">

                    <Label text="Data final" styleClass="field-label"/>

                    <DatePicker
                        fx:id="dpDataFinal"
                        prefWidth="180.0"/>

                </VBox>

                <VBox alignment="BOTTOM_LEFT">

                    <Button
                        fx:id="btnBuscar"
                        text="Buscar"
                        onAction="#buscarRelatorios"
                        prefWidth="120.0"
                        styleClass="btn, btn-primary"/>

                </VBox>

            </HBox>

            <TabPane
                styleClass="reports-tab-pane"
                tabClosingPolicy="UNAVAILABLE"
                VBox.vgrow="ALWAYS">

                <tabs>

                    <!-- ==================================================
                         VENDAS POR PERÍODO
                         ================================================== -->

                    <Tab text="Vendas por período">

                        <VBox spacing="18.0">

                            <padding>
                                <Insets
                                    top="22"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                            </padding>

                            <Label
                                text="Vendas por período"
                                styleClass="section-title"/>

                            <HBox spacing="20.0">

                                <HBox
                                    styleClass="dashboard-stat-card"
                                    spacing="14"
                                    alignment="CENTER_LEFT"
                                    HBox.hgrow="ALWAYS">

                                    <StackPane styleClass="dashboard-stat-icon">
                                        <Label text="🧾" styleClass="stat-icon"/>
                                    </StackPane>

                                    <VBox spacing="4">

                                        <Label
                                            text="Quantidade de vendas"
                                            styleClass="dashboard-stat-label"/>

                                        <Label
                                            fx:id="lblQuantidadeVendas"
                                            text="0"
                                            styleClass="dashboard-stat-value"/>

                                    </VBox>

                                </HBox>

                                <HBox
                                    styleClass="dashboard-finance-card"
                                    spacing="14"
                                    alignment="CENTER_LEFT"
                                    HBox.hgrow="ALWAYS">

                                    <StackPane styleClass="dashboard-finance-icon">
                                        <Label text="💰" styleClass="stat-icon"/>
                                    </StackPane>

                                    <VBox spacing="4">

                                        <Label
                                            text="Faturamento"
                                            styleClass="dashboard-finance-label"/>

                                        <Label
                                            fx:id="lblFaturamento"
                                            text="R$ 0,00"
                                            styleClass="dashboard-finance-value"/>

                                    </VBox>

                                </HBox>

                            </HBox>

                            <TableView
                                fx:id="tabelaVendas"
                                prefHeight="380.0">

                                <placeholder>
                                    <Label
                                        text="Nenhuma venda encontrada para o período selecionado."
                                        styleClass="table-placeholder"/>
                                </placeholder>

                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>

                                <columns>

                                    <TableColumn
                                        fx:id="colId"
                                        text="ID"
                                        prefWidth="70.0"/>

                                    <TableColumn
                                        fx:id="colData"
                                        text="Data"
                                        prefWidth="170.0"/>

                                    <TableColumn
                                        fx:id="colCliente"
                                        text="Cliente"
                                        prefWidth="280.0"/>

                                    <TableColumn
                                        fx:id="colValor"
                                        text="Valor"
                                        prefWidth="160.0"/>

                                    <TableColumn
                                        fx:id="colStatus"
                                        text="Status"
                                        prefWidth="160.0"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </Tab>

                    <!-- ==================================================
                         PRODUTOS MAIS VENDIDOS
                         ================================================== -->

                    <Tab text="Produtos mais vendidos">

                        <VBox spacing="18.0">

                            <padding>
                                <Insets
                                    top="22"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                            </padding>

                            <VBox spacing="2.0">

                                <Label
                                    text="Produtos mais vendidos"
                                    styleClass="section-title"/>

                                <Label
                                    text="Ranking dos produtos vendidos no período selecionado."
                                    styleClass="page-subtitle"/>

                            </VBox>

                            <HBox
                                styleClass="dashboard-stat-card"
                                spacing="14"
                                alignment="CENTER_LEFT"
                                maxWidth="280.0">

                                <StackPane styleClass="dashboard-stat-icon">
                                    <Label text="📊" styleClass="stat-icon"/>
                                </StackPane>

                                <VBox spacing="4">

                                    <Label
                                        text="Produtos no ranking"
                                        styleClass="dashboard-stat-label"/>

                                    <Label
                                        fx:id="lblProdutosRanking"
                                        text="0"
                                        styleClass="dashboard-stat-value"/>

                                </VBox>

                            </HBox>

                            <TableView
                                fx:id="tabelaProdutosMaisVendidos"
                                prefHeight="380.0">

                                <placeholder>
                                    <Label
                                        text="Nenhum produto vendido no período selecionado."
                                        styleClass="table-placeholder"/>
                                </placeholder>

                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>

                                <columns>

                                    <TableColumn
                                        fx:id="colProdutoId"
                                        text="ID"
                                        prefWidth="80.0"/>

                                    <TableColumn
                                        fx:id="colProdutoNome"
                                        text="Produto"
                                        prefWidth="400.0"/>

                                    <TableColumn
                                        fx:id="colQuantidadeVendida"
                                        text="Quantidade vendida"
                                        prefWidth="200.0"/>

                                    <TableColumn
                                        fx:id="colProdutoValorTotal"
                                        text="Valor total"
                                        prefWidth="200.0"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </Tab>

                    <!-- ==================================================
                         FATURAMENTO
                         ================================================== -->

                    <Tab text="Faturamento">

                        <VBox spacing="22.0">

                            <padding>
                                <Insets
                                    top="22"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                            </padding>

                            <VBox spacing="2.0">

                                <Label
                                    text="Faturamento por período"
                                    styleClass="section-title"/>

                                <Label
                                    text="Resumo financeiro das vendas concluídas no período selecionado."
                                    styleClass="page-subtitle"/>

                            </VBox>

                            <HBox spacing="20.0">

                                <HBox
                                    styleClass="dashboard-finance-card"
                                    spacing="14"
                                    alignment="CENTER_LEFT"
                                    HBox.hgrow="ALWAYS">

                                    <StackPane styleClass="dashboard-finance-icon">
                                        <Label text="💰" styleClass="stat-icon"/>
                                    </StackPane>

                                    <VBox spacing="4">

                                        <Label
                                            text="Faturamento total"
                                            styleClass="dashboard-finance-label"/>

                                        <Label
                                            fx:id="lblFaturamentoPeriodo"
                                            text="R$ 0,00"
                                            styleClass="dashboard-finance-value"/>

                                    </VBox>

                                </HBox>

                                <HBox
                                    styleClass="dashboard-stat-card"
                                    spacing="14"
                                    alignment="CENTER_LEFT"
                                    HBox.hgrow="ALWAYS">

                                    <StackPane styleClass="dashboard-stat-icon">
                                        <Label text="✅" styleClass="stat-icon"/>
                                    </StackPane>

                                    <VBox spacing="4">

                                        <Label
                                            text="Vendas concluídas"
                                            styleClass="dashboard-stat-label"/>

                                        <Label
                                            fx:id="lblVendasConcluidas"
                                            text="0"
                                            styleClass="dashboard-stat-value"/>

                                    </VBox>

                                </HBox>

                                <HBox
                                    styleClass="dashboard-stat-card"
                                    spacing="14"
                                    alignment="CENTER_LEFT"
                                    HBox.hgrow="ALWAYS">

                                    <StackPane styleClass="dashboard-stat-icon">
                                        <Label text="📈" styleClass="stat-icon"/>
                                    </StackPane>

                                    <VBox spacing="4">

                                        <Label
                                            text="Ticket médio"
                                            styleClass="dashboard-stat-label"/>

                                        <Label
                                            fx:id="lblTicketMedio"
                                            text="R$ 0,00"
                                            styleClass="dashboard-stat-value"/>

                                    </VBox>

                                </HBox>

                            </HBox>

                        </VBox>

                    </Tab>

                    <!-- ==================================================
                         ESTOQUE BAIXO
                         ================================================== -->

                    <Tab text="Estoque baixo">

                        <VBox spacing="18.0">

                            <padding>
                                <Insets
                                    top="22"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                            </padding>

                            <VBox spacing="2.0">

                                <Label
                                    text="Estoque baixo"
                                    styleClass="section-title"/>

                                <Label
                                    text="Produtos com 10 unidades ou menos em estoque."
                                    styleClass="page-subtitle"/>

                            </VBox>

                            <HBox spacing="20.0">

                                <HBox
                                    styleClass="dashboard-stat-card"
                                    spacing="14"
                                    alignment="CENTER_LEFT"
                                    HBox.hgrow="ALWAYS">

                                    <StackPane styleClass="dashboard-pending-icon">
                                        <Label text="⚠️" styleClass="stat-icon"/>
                                    </StackPane>

                                    <VBox spacing="4">

                                        <Label
                                            text="Produtos com estoque baixo"
                                            styleClass="dashboard-stat-label"/>

                                        <Label
                                            fx:id="lblProdutosEstoqueBaixo"
                                            text="0"
                                            styleClass="dashboard-pending-value"/>

                                    </VBox>

                                </HBox>

                                <HBox
                                    styleClass="dashboard-stat-card"
                                    spacing="14"
                                    alignment="CENTER_LEFT"
                                    HBox.hgrow="ALWAYS">

                                    <StackPane styleClass="report-danger-icon">
                                        <Label text="🚫" styleClass="report-danger-symbol"/>
                                    </StackPane>

                                    <VBox spacing="4">

                                        <Label
                                            text="Produtos sem estoque"
                                            styleClass="dashboard-stat-label"/>

                                        <Label
                                            fx:id="lblProdutosSemEstoque"
                                            text="0"
                                            styleClass="report-danger-value"/>

                                    </VBox>

                                </HBox>

                            </HBox>

                            <TableView
                                fx:id="tabelaEstoqueBaixo"
                                prefHeight="360.0">

                                <placeholder>
                                    <Label
                                        text="Nenhum produto com estoque baixo. 🎉"
                                        styleClass="table-placeholder"/>
                                </placeholder>

                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>

                                <columns>

                                    <TableColumn
                                        fx:id="colEstoqueId"
                                        text="ID"
                                        prefWidth="90.0"/>

                                    <TableColumn
                                        fx:id="colEstoqueProduto"
                                        text="Produto"
                                        prefWidth="430.0"/>

                                    <TableColumn
                                        fx:id="colEstoqueQuantidade"
                                        text="Quantidade"
                                        prefWidth="180.0"/>

                                    <TableColumn
                                        fx:id="colEstoqueSituacao"
                                        text="Situação"
                                        prefWidth="200.0"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </Tab>

                    <!-- ==================================================
                         CLIENTES QUE MAIS COMPRARAM
                         ================================================== -->

                    <Tab text="Clientes que mais compraram">

                        <VBox spacing="18.0">

                            <padding>
                                <Insets
                                    top="22"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                            </padding>

                            <VBox spacing="2.0">

                                <Label
                                    text="Clientes que mais compraram"
                                    styleClass="section-title"/>

                                <Label
                                    text="Ranking dos clientes com maior valor em compras concluídas no período selecionado."
                                    styleClass="page-subtitle"/>

                            </VBox>

                            <HBox
                                styleClass="dashboard-stat-card"
                                spacing="14"
                                alignment="CENTER_LEFT"
                                maxWidth="280.0">

                                <StackPane styleClass="dashboard-stat-icon">
                                    <Label text="👥" styleClass="stat-icon"/>
                                </StackPane>

                                <VBox spacing="4">

                                    <Label
                                        text="Clientes no ranking"
                                        styleClass="dashboard-stat-label"/>

                                    <Label
                                        fx:id="lblClientesRanking"
                                        text="0"
                                        styleClass="dashboard-stat-value"/>

                                </VBox>

                            </HBox>

                            <TableView
                                fx:id="tabelaClientesMaisCompraram"
                                prefHeight="380.0">

                                <placeholder>
                                    <Label
                                        text="Nenhuma compra concluída no período selecionado."
                                        styleClass="table-placeholder"/>
                                </placeholder>

                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>

                                <columns>

                                    <TableColumn
                                        fx:id="colClienteId"
                                        text="ID"
                                        prefWidth="90.0"/>

                                    <TableColumn
                                        fx:id="colClienteNome"
                                        text="Cliente"
                                        prefWidth="420.0"/>

                                    <TableColumn
                                        fx:id="colClienteQuantidadeCompras"
                                        text="Quantidade de compras"
                                        prefWidth="220.0"/>

                                    <TableColumn
                                        fx:id="colClienteValorTotal"
                                        text="Total gasto"
                                        prefWidth="220.0"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </Tab>

                </tabs>

            </TabPane>

        </VBox>

    </children>

</AnchorPane>
