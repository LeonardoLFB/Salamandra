<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    prefHeight="740.0"
    prefWidth="980.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.FornecedorController"
    styleClass="page-background">

    <stylesheets>
        <URL value="@application.css"/>
    </stylesheets>

    <ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        styleClass="page-scroll"
        AnchorPane.topAnchor="0.0"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0">

        <content>

            <VBox
                spacing="20.0"
                styleClass="page-background">

                <padding>
                    <Insets
                        top="28.0"
                        right="34.0"
                        bottom="28.0"
                        left="34.0"/>
                </padding>

                <!-- =====================================================
                     CABEÇALHO
                     ===================================================== -->

                <HBox
                    alignment="CENTER_LEFT"
                    spacing="16.0">

                    <VBox spacing="5.0">

                        <Label
                            text="Fornecedores"
                            styleClass="page-title"/>

                        <Label
                            text="Cadastre, consulte e gerencie os fornecedores dos seus produtos."
                            styleClass="page-subtitle"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- TOTAL -->

                    <VBox
                        alignment="CENTER"
                        spacing="2.0"
                        minWidth="105.0"
                        styleClass="supplier-stat-card">

                        <Label
                            fx:id="lblTotal"
                            text="0"
                            styleClass="supplier-stat-value"/>

                        <Label
                            text="Total"
                            styleClass="supplier-stat-label"/>

                    </VBox>

                    <!-- ATIVOS -->

                    <VBox
                        alignment="CENTER"
                        spacing="2.0"
                        minWidth="105.0"
                        styleClass="supplier-stat-card">

                        <Label
                            fx:id="lblAtivos"
                            text="0"
                            styleClass="supplier-stat-value-active"/>

                        <Label
                            text="Ativos"
                            styleClass="supplier-stat-label"/>

                    </VBox>

                </HBox>

                <!-- =====================================================
                     FORMULÁRIO
                     ===================================================== -->

                <VBox
                    spacing="18.0"
                    styleClass="form-card">

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="10.0">

                        <VBox spacing="4.0">

                            <Label
                                fx:id="lblFormTitulo"
                                text="Cadastrar Novo Fornecedor"
                                styleClass="form-section-title"/>

                            <Label
                                text="Preencha os dados comerciais e de contato do fornecedor."
                                styleClass="form-section-subtitle"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label
                            fx:id="lblModoEdicao"
                            text="EDITANDO"
                            visible="false"
                            managed="false"
                            styleClass="badge, badge-ativo"/>

                    </HBox>

                    <Separator/>

                    <!-- =================================================
                         DADOS PRINCIPAIS
                         ================================================= -->

                    <GridPane
                        hgap="18.0"
                        vgap="16.0">

                        <columnConstraints>

                            <ColumnConstraints percentWidth="45.0"/>

                            <ColumnConstraints percentWidth="27.5"/>

                            <ColumnConstraints percentWidth="27.5"/>

                        </columnConstraints>

                        <!-- NOME -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0">

                            <Label
                                text="Nome do fornecedor *"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfNome"
                                promptText="Ex.: Incensos do Oriente Ltda"/>

                        </VBox>

                        <!-- DOCUMENTO -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0">

                            <Label
                                text="CNPJ / CPF"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfCnpj"
                                promptText="00.000.000/0000-00"/>

                        </VBox>

                        <!-- CONTATO -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0">

                            <Label
                                text="Telefone"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfContato"
                                promptText="(00) 00000-0000"/>

                        </VBox>

                    </GridPane>

                    <!-- =================================================
                         CONTATO E SITUAÇÃO
                         ================================================= -->

                    <VBox spacing="4.0">

                        <Label
                            text="CONTATO E SITUAÇÃO"
                            styleClass="form-section-title"/>

                        <Label
                            text="Informe os dados adicionais e a situação atual do fornecedor."
                            styleClass="form-section-subtitle"/>

                    </VBox>

                    <Separator/>

                    <GridPane
                        hgap="18.0"
                        vgap="16.0">

                        <columnConstraints>

                            <ColumnConstraints percentWidth="35.0"/>

                            <ColumnConstraints percentWidth="45.0"/>

                            <ColumnConstraints percentWidth="20.0"/>

                        </columnConstraints>

                        <!-- EMAIL -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0">

                            <Label
                                text="E-mail"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfEmail"
                                promptText="contato@empresa.com"/>

                        </VBox>

                        <!-- ENDEREÇO -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0">

                            <Label
                                text="Endereço"
                                styleClass="field-label-strong"/>

                            <TextField
                                fx:id="tfEndereco"
                                promptText="Ex.: Rua das Especiarias, 123"/>

                        </VBox>

                        <!-- STATUS -->

                        <VBox
                            spacing="6.0"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0">

                            <Label
                                text="Status"
                                styleClass="field-label-strong"/>

                            <ComboBox
                                fx:id="cbStatus"
                                maxWidth="Infinity"
                                promptText="Selecione"/>

                        </VBox>

                    </GridPane>

                    <!-- =================================================
                         AÇÕES
                         ================================================= -->

                    <HBox
                        alignment="CENTER_RIGHT"
                        spacing="12.0"
                        styleClass="form-actions">

                        <Button
                            fx:id="btnCancelarEdicao"
                            text="Cancelar edição"
                            onAction="#onLimparFormulario"
                            visible="false"
                            managed="false"
                            styleClass="btn, btn-secondary"/>

                        <Button
                            fx:id="btnLimpar"
                            text="Limpar"
                            onAction="#onLimparFormulario"
                            styleClass="btn, btn-secondary"/>

                        <Button
                            fx:id="btnCadastrar"
                            text="Cadastrar fornecedor"
                            defaultButton="true"
                            onAction="#onCadastrarFornecedor"
                            styleClass="btn, btn-primary"/>

                    </HBox>

                </VBox>

                <!-- =====================================================
                     LISTAGEM
                     ===================================================== -->

                <VBox
                    spacing="14.0"
                    styleClass="list-card">

                    <!-- CABEÇALHO DA LISTA -->

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="12.0">

                        <VBox spacing="3.0">

                            <Label
                                text="Fornecedores cadastrados"
                                styleClass="dashboard-section-title"/>

                            <Label
                                text="Pesquise, filtre, edite ou exclua fornecedores."
                                styleClass="form-section-subtitle"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button
                            fx:id="btnAtualizar"
                            text="Atualizar"
                            onAction="#onAtualizar"
                            styleClass="btn, btn-secondary"/>

                    </HBox>

                    <!-- BUSCA E FILTRO -->

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="12.0">

                        <HBox
                            alignment="CENTER_LEFT"
                            spacing="8.0"
                            styleClass="search-bar"
                            HBox.hgrow="ALWAYS">

                            <Label text="🔍"/>

                            <TextField
                                fx:id="tfBusca"
                                promptText="Buscar por nome, documento, contato ou e-mail..."
                                HBox.hgrow="ALWAYS"/>

                        </HBox>

                        <ComboBox
                            fx:id="cbStatusFiltro"
                            prefWidth="160.0"
                            promptText="Status"/>

                    </HBox>

                    <!-- TABELA -->

                    <TableView
                        fx:id="tableFornecedores"
                        prefHeight="330.0"
                        minHeight="280.0">

                        <columns>

                            <TableColumn
                                fx:id="colNome"
                                prefWidth="230.0"
                                text="FORNECEDOR"/>

                            <TableColumn
                                fx:id="colCnpj"
                                prefWidth="170.0"
                                text="CNPJ / CPF"/>

                            <TableColumn
                                fx:id="colContato"
                                prefWidth="150.0"
                                text="CONTATO"/>

                            <TableColumn
                                fx:id="colEmail"
                                prefWidth="220.0"
                                text="E-MAIL"/>

                            <TableColumn
                                fx:id="colStatus"
                                prefWidth="110.0"
                                text="STATUS"/>

                            <TableColumn
                                fx:id="colAcoes"
                                prefWidth="100.0"
                                text="AÇÕES"/>

                        </columns>

                    </TableView>

                    <!-- RODAPÉ -->

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="12.0"
                        styleClass="supplier-list-footer">

                        <Label
                            fx:id="lblStatusBar"
                            text="Pronto"
                            styleClass="supplier-footer-text"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label
                            fx:id="lblExibindo"
                            text="Exibindo 0 de 0"
                            styleClass="supplier-footer-text"/>

                    </HBox>

                </VBox>

            </VBox>

        </content>

    </ScrollPane>

</AnchorPane>