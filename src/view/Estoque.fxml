<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    prefHeight="680.0"
    prefWidth="900.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.EstoqueController"
    styleClass="page-background">

    <stylesheets>
        <URL value="@application.css"/>
    </stylesheets>

    <ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        styleClass="page-scroll"
        AnchorPane.topAnchor="0.0"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0">

        <content>

            <VBox
                spacing="20.0"
                styleClass="page-background">

                <padding>
                    <Insets
                        top="28.0"
                        right="34.0"
                        bottom="28.0"
                        left="34.0"/>
                </padding>

                <!-- =====================================================
                     CABEÇALHO
                     ===================================================== -->

                <VBox spacing="5.0">

                    <Label
                        text="Estoque"
                        styleClass="page-title"/>

                    <Label
                        text="Consulte produtos, acompanhe quantidades e controle seu inventário."
                        styleClass="page-subtitle"/>

                </VBox>

                <!-- =====================================================
                     FILTROS
                     ===================================================== -->

                <VBox
                    spacing="14.0"
                    styleClass="list-card">

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="12.0">

                        <VBox spacing="3.0">

                            <Label
                                text="Consulta de estoque"
                                styleClass="dashboard-section-title"/>

                            <Label
                                text="Pesquise produtos e filtre pela situação atual do estoque."
                                styleClass="form-section-subtitle"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button
                            fx:id="btnAtualizar"
                            text="Atualizar"
                            styleClass="btn, btn-secondary"/>

                    </HBox>

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="12.0">

                        <HBox
                            alignment="CENTER_LEFT"
                            spacing="8.0"
                            styleClass="search-bar"
                            HBox.hgrow="ALWAYS">

                            <Label text="🔍"/>

                            <TextField
                                fx:id="txtBuscar"
                                promptText="Buscar por nome ou código..."
                                HBox.hgrow="ALWAYS"/>

                        </HBox>

                        <ComboBox
                            fx:id="cbFiltroStatus"
                            prefWidth="185.0"
                            promptText="Filtrar estoque"/>

                    </HBox>

                </VBox>

                <!-- =====================================================
                     TABELA
                     ===================================================== -->

                <VBox
                    spacing="14.0"
                    styleClass="list-card">

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="12.0">

                        <VBox spacing="3.0">

                            <Label
                                text="Produtos em estoque"
                                styleClass="dashboard-section-title"/>

                            <Label
                                text="Visualize quantidades, preços e lotes dos produtos cadastrados."
                                styleClass="form-section-subtitle"/>

                        </VBox>

                    </HBox>

                    <TableView
                        fx:id="productTable"
                        prefHeight="430.0"
                        minHeight="320.0">

                        <columns>

                            <TableColumn
                                fx:id="colNomeProduto"
                                prefWidth="260.0"
                                text="PRODUTO"/>

                            <TableColumn
                                fx:id="colCodigo"
                                prefWidth="100.0"
                                text="CÓDIGO"/>

                            <TableColumn
                                fx:id="colQuantidade"
                                prefWidth="110.0"
                                text="QUANTIDADE"/>

                            <TableColumn
                                fx:id="colPrecoCusto"
                                prefWidth="130.0"
                                text="PREÇO CUSTO"/>

                            <TableColumn
                                fx:id="colPrecoVenda"
                                prefWidth="130.0"
                                text="PREÇO VENDA"/>

                            <TableColumn
                                fx:id="colLote"
                                prefWidth="110.0"
                                text="LOTE"/>

                            <TableColumn
                                fx:id="colAcoes"
                                prefWidth="90.0"
                                text="AÇÕES"/>

                        </columns>

                    </TableView>

                    <!-- =================================================
                         RESUMO
                         ================================================= -->

                    <HBox
                        alignment="CENTER_LEFT"
                        spacing="14.0"
                        styleClass="stock-footer">

                        <Label
                            fx:id="lblStatus"
                            text="Pronto"
                            styleClass="stock-footer-text"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox
                            alignment="CENTER"
                            spacing="2.0">

                            <Label
                                text="Produtos"
                                styleClass="stock-summary-label"/>

                            <Label
                                fx:id="lblTotalItens"
                                text="0"
                                styleClass="stock-summary-value"/>

                        </VBox>

                        <Separator orientation="VERTICAL"/>

                        <VBox
                            alignment="CENTER_RIGHT"
                            spacing="2.0">

                            <Label
                                text="Valor do estoque"
                                styleClass="stock-summary-label"/>

                            <HBox
                                alignment="CENTER_RIGHT"
                                spacing="4.0">

                                <Label
                                    text="R$"
                                    styleClass="stock-summary-currency"/>

                                <Label
                                    fx:id="lblValorTotal"
                                    text="0,00"
                                    styleClass="stock-summary-value"/>

                            </HBox>

                        </VBox>

                    </HBox>

                </VBox>

            </VBox>

        </content>

    </ScrollPane>

</AnchorPane>