<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="680.0" prefWidth="900.0" style="-fx-background-color: #F3F4F6;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EstoqueController">

    <stylesheets>
        <URL value="@application.css" />
    </stylesheets>

    <!-- Container principal -->
    <VBox prefHeight="680.0" prefWidth="900.0" spacing="18" AnchorPane.bottomAnchor="18" AnchorPane.leftAnchor="18" AnchorPane.rightAnchor="18" AnchorPane.topAnchor="18">

        <!-- Cabeçalho -->
        <VBox spacing="6">
            <Label style="-fx-font-size:28px; -fx-font-weight:bold;" text="Estoque" />
            <Label style="-fx-text-fill:#6B7280;" text="Gerencie os produtos, quantidades e preços do seu inventário." />
        </VBox>

        <!-- Card: Busca / filtros -->
        <VBox spacing="10" style="-fx-background-color:white; -fx-padding:12; -fx-background-radius:8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 6, 0, 0, 1);">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color:#F8FAFB; -fx-padding:10; -fx-background-radius:6;" HBox.hgrow="ALWAYS">
                    <TextField fx:id="txtBuscar" promptText="Buscar por nome ou código..." HBox.hgrow="ALWAYS" />
                </HBox>

                <ComboBox fx:id="cbFiltroStatus" prefWidth="160" promptText="Filtrar Status" />
                <Button fx:id="btnAtualizar" styleClass="btn, btn-primary" text="🔄 Atualizar" />
            </HBox>
        </VBox>

        <!-- Tabela de produtos -->
        <TableView fx:id="productTable" prefHeight="500" style="-fx-background-radius:8; -fx-background-color:white;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNomeProduto" prefWidth="280" text="Nome do Produto" />
                <TableColumn fx:id="colCodigo" prefWidth="120" text="Código" />
                <TableColumn fx:id="colQuantidade" prefWidth="100" text="Quantidade" />
                <TableColumn fx:id="colPrecoCusto" prefWidth="110" text="Preço Custo" />
                <TableColumn fx:id="colPrecoVenda" prefWidth="110" text="Preço Venda" />
                <TableColumn fx:id="colLote" prefWidth="100" text="Lote" />
                <TableColumn fx:id="colAcoes" prefWidth="80" text="Ações" />
            </columns>
        </TableView>

        <!-- Rodapé resumo -->
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color:white; -fx-padding:10; -fx-background-radius:8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 4, 0, 0, 1);">
            <Label fx:id="lblStatus" text="Pronto" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Total de produtos:" />
            <Label fx:id="lblTotalItens" text="0" />
            <Separator orientation="VERTICAL" />
            <Label text="Valor total em estoque: R$" />
            <Label fx:id="lblValorTotal" text="0.00" />
        </HBox>

    </VBox>

</AnchorPane>