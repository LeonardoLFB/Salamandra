<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane prefHeight="680.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MenuController">

    <stylesheets>
        <URL value="@application.css" />
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <!-- ================= BARRA SUPERIOR ================= -->

            <top>

                <HBox alignment="CENTER_LEFT"
                      prefHeight="64.0"
                      spacing="10"
                      styleClass="app-header"
                      BorderPane.alignment="CENTER">

                    <padding>
                        <Insets bottom="8"
                                left="14"
                                right="14"
                                top="8" />
                    </padding>

                    <!-- MENU -->

                    <Label fx:id="Menu"
                           styleClass="menu-toggle"
                           text="☰  MENU" />

                    <Label fx:id="MenuClose"
                           styleClass="menu-toggle"
                           text="✕  MENU" />

                    <Separator orientation="VERTICAL" />

                    <!-- INÍCIO -->

                    <VBox fx:id="btInicio"
                          spacing="0"
                          styleClass="inicio-link"
                          onMouseClicked="#voltarDashboard">

                        <Label styleClass="app-header-title"
                               text="Salamandra Incensária" />

                        <Label styleClass="app-header-sub"
                               text="Sistema de Gestão Comercial" />

                    </VBox>

                    <!-- EMPURRA OS BOTÕES PARA A DIREITA -->

                    <Region HBox.hgrow="ALWAYS" />

                    <!-- ================= ATALHOS ================= -->

                    <JFXButton onAction="#OnBtClientesClick"
                               styleClass="nav-btn"
                               text="Clientes">

                        <graphic>

                            <ImageView fitHeight="20.0"
                                       fitWidth="20.0"
                                       pickOnBounds="true"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@../img/usuario.png" />
                                </image>

                            </ImageView>

                        </graphic>

                    </JFXButton>


                    <JFXButton onAction="#OnBtFornecedoresClick"
                               styleClass="nav-btn"
                               text="Fornecedores">

                        <graphic>

                            <ImageView fitHeight="20.0"
                                       fitWidth="20.0"
                                       pickOnBounds="true"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@../img/fornecedor.png" />
                                </image>

                            </ImageView>

                        </graphic>

                    </JFXButton>


                    <JFXButton onAction="#OnBtVendasClick"
                               styleClass="nav-btn"
                               text="Vendas">

                        <graphic>

                            <ImageView fitHeight="20.0"
                                       fitWidth="20.0"
                                       pickOnBounds="true"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@../img/venda.png" />
                                </image>

                            </ImageView>

                        </graphic>

                    </JFXButton>


                    <!-- SEPARADOR DO LOGOUT -->

                    <Separator orientation="VERTICAL"
                               prefHeight="28.0"
                               opacity="0.35" />


                    <!-- ================= LOGOUT ================= -->

              <JFXButton fx:id="btSair"
           onAction="#OnBtSairClick"
           styleClass="logout-btn"
           text="Sair"
           alignment="CENTER"
           minWidth="70.0"
           prefWidth="70.0"
           minHeight="38.0"
           prefHeight="38.0" />

                </HBox>

            </top>


            <!-- ================= SIDEBAR ================= -->

            <left>

                <AnchorPane fx:id="Slider"
                            prefWidth="176.0"
                            styleClass="sidebar"
                            BorderPane.alignment="CENTER">

                    <children>

                        <VBox spacing="2"
                              AnchorPane.bottomAnchor="0.0"
                              AnchorPane.leftAnchor="0.0"
                              AnchorPane.rightAnchor="0.0"
                              AnchorPane.topAnchor="16.0">

                            <!-- CADASTROS -->

                            <Label styleClass="sidebar-title"
                                   text="CADASTROS" />


                            <JFXButton fx:id="btProdutos"
                                       maxWidth="Infinity"
                                       onAction="#OnBtProdutosClick"
                                       styleClass="nav-item"
                                       text="Produtos">

                                <graphic>

                                    <ImageView fitHeight="20.0"
                                               fitWidth="20.0"
                                               pickOnBounds="true"
                                               preserveRatio="true">

                                        <image>
                                            <Image url="@../img/Stock.png" />
                                        </image>

                                    </ImageView>

                                </graphic>

                            </JFXButton>


                            <JFXButton fx:id="btClientes"
                                       maxWidth="Infinity"
                                       onAction="#OnBtClientesClick"
                                       styleClass="nav-item"
                                       text="Clientes">

                                <graphic>

                                    <ImageView fitHeight="20.0"
                                               fitWidth="20.0"
                                               pickOnBounds="true"
                                               preserveRatio="true">

                                        <image>
                                            <Image url="@../img/usuario.png" />
                                        </image>

                                    </ImageView>

                                </graphic>

                            </JFXButton>


                            <JFXButton fx:id="btFornecedores"
                                       maxWidth="Infinity"
                                       onAction="#OnBtFornecedoresClick"
                                       styleClass="nav-item"
                                       text="Fornecedores">

                                <graphic>

                                    <ImageView fitHeight="20.0"
                                               fitWidth="20.0"
                                               pickOnBounds="true"
                                               preserveRatio="true">

                                        <image>
                                            <Image url="@../img/fornecedor.png" />
                                        </image>

                                    </ImageView>

                                </graphic>

                            </JFXButton>


                            <!-- OPERAÇÃO -->

                            <Label styleClass="sidebar-title"
                                   text="OPERAÇÃO">

                                <padding>
                                    <Insets top="14" />
                                </padding>

                            </Label>


                            <JFXButton fx:id="btVendas"
                                       maxWidth="Infinity"
                                       onAction="#OnBtVendasClick"
                                       styleClass="nav-item"
                                       text="Vendas">

                                <graphic>

                                    <ImageView fitHeight="20.0"
                                               fitWidth="20.0"
                                               pickOnBounds="true"
                                               preserveRatio="true">

                                        <image>
                                            <Image url="@../img/venda.png" />
                                        </image>

                                    </ImageView>

                                </graphic>

                            </JFXButton>


                            <JFXButton fx:id="btEstoque"
                                       maxWidth="Infinity"
                                       onAction="#OnBtEstoqueClick"
                                       styleClass="nav-item"
                                       text="Estoque">

                                <graphic>

                                    <ImageView fitHeight="20.0"
                                               fitWidth="20.0"
                                               pickOnBounds="true"
                                               preserveRatio="true">

                                        <image>
                                            <Image url="@../img/Products.png" />
                                        </image>

                                    </ImageView>

                                </graphic>

                            </JFXButton>


                            <!-- SISTEMA -->

                            <Label styleClass="sidebar-title"
                                   text="SISTEMA">

                                <padding>
                                    <Insets top="14" />
                                </padding>

                            </Label>


                            <JFXButton fx:id="btUsuarios"
                                       maxWidth="Infinity"
                                       onAction="#OnBtUsuariosClick"
                                       styleClass="nav-item"
                                       text="Usuários">

                                <graphic>

                                    <ImageView fitHeight="20.0"
                                               fitWidth="20.0"
                                               pickOnBounds="true"
                                               preserveRatio="true">

                                        <image>
                                            <Image url="@../img/adicionar-amigo.png" />
                                        </image>

                                    </ImageView>

                                </graphic>

                            </JFXButton>

                        </VBox>

                    </children>

                </AnchorPane>

            </left>


            <!-- ================= PAINEL CENTRAL ================= -->

            <center>

                <StackPane fx:id="conteudoPrincipal">

                    <VBox fx:id="dashboardPrincipal"
                          alignment="TOP_CENTER"
                          spacing="22"
                          styleClass="dashboard">

                        <padding>

                            <Insets bottom="30"
                                    left="34"
                                    right="34"
                                    top="30" />

                        </padding>


                        <!-- ================= BOAS-VINDAS ================= -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="18">

                            <ImageView fitHeight="82.0"
                                       fitWidth="82.0"
                                       pickOnBounds="true"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@../img/LogoPreto.png" />
                                </image>

                            </ImageView>


                            <VBox spacing="4">

                                <Label styleClass="welcome-title"
                                       text="Bem-vindo à Salamandra" />

                                <Label fx:id="lblBoasVindas"
                                       styleClass="welcome-sub"
                                       text="Selecione um módulo no menu para começar." />

                            </VBox>

                        </HBox>


                        <!-- ================= INDICADORES ================= -->

                        <HBox alignment="CENTER"
                              spacing="16">


                            <!-- CLIENTES -->

                            <VBox alignment="CENTER"
                                  spacing="4"
                                  styleClass="stat-card"
                                  HBox.hgrow="ALWAYS">

                                <padding>
                                    <Insets bottom="18"
                                            left="14"
                                            right="14"
                                            top="18" />
                                </padding>

                                <ImageView fitHeight="28.0"
                                           fitWidth="28.0"
                                           preserveRatio="true">

                                    <image>
                                        <Image url="@../img/usuario.png" />
                                    </image>

                                </ImageView>

                                <Label fx:id="lblQtdClientes"
                                       styleClass="stat-value"
                                       text="—" />

                                <Label styleClass="stat-label"
                                       text="CLIENTES" />

                            </VBox>


                            <!-- PRODUTOS -->

                            <VBox alignment="CENTER"
                                  spacing="4"
                                  styleClass="stat-card"
                                  HBox.hgrow="ALWAYS">

                                <padding>
                                    <Insets bottom="18"
                                            left="14"
                                            right="14"
                                            top="18" />
                                </padding>

                                <ImageView fitHeight="28.0"
                                           fitWidth="28.0"
                                           preserveRatio="true">

                                    <image>
                                        <Image url="@../img/Products.png" />
                                    </image>

                                </ImageView>

                                <Label fx:id="lblQtdProdutos"
                                       styleClass="stat-value, stat-value-azul"
                                       text="—" />

                                <Label styleClass="stat-label"
                                       text="PRODUTOS" />

                            </VBox>


                            <!-- ESTOQUE BAIXO -->

                            <VBox alignment="CENTER"
                                  spacing="4"
                                  styleClass="stat-card"
                                  HBox.hgrow="ALWAYS">

                                <padding>
                                    <Insets bottom="18"
                                            left="14"
                                            right="14"
                                            top="18" />
                                </padding>

                                <ImageView fitHeight="28.0"
                                           fitWidth="28.0"
                                           preserveRatio="true">

                                    <image>
                                        <Image url="@../img/Stock.png" />
                                    </image>

                                </ImageView>

                                <Label fx:id="lblEstoqueBaixo"
                                       styleClass="stat-value, stat-value-alerta"
                                       text="—" />

                                <Label styleClass="stat-label"
                                       text="ESTOQUE BAIXO" />

                            </VBox>


                            <!-- VENDAS -->

                            <VBox alignment="CENTER"
                                  spacing="4"
                                  styleClass="stat-card"
                                  HBox.hgrow="ALWAYS">

                                <padding>
                                    <Insets bottom="18"
                                            left="14"
                                            right="14"
                                            top="18" />
                                </padding>

                                <ImageView fitHeight="28.0"
                                           fitWidth="28.0"
                                           preserveRatio="true">

                                    <image>
                                        <Image url="@../img/venda.png" />
                                    </image>

                                </ImageView>

                                <Label fx:id="lblQtdVendas"
                                       styleClass="stat-value, stat-value-verde"
                                       text="—" />

                                <Label styleClass="stat-label"
                                       text="VENDAS" />

                            </VBox>

                        </HBox>


                        <!-- ================= FATURAMENTO ================= -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="14"
                              styleClass="card">

                            <padding>

                                <Insets bottom="16"
                                        left="20"
                                        right="20"
                                        top="16" />

                            </padding>


                            <VBox spacing="2">

                                <Label styleClass="stat-label"
                                       text="FATURAMENTO (VENDAS CONCLUÍDAS)" />

                                <Label fx:id="lblFaturamento"
                                       style="-fx-font-size:22px;
                                              -fx-font-weight:bold;
                                              -fx-text-fill:#15803D;"
                                       text="R$ 0,00" />

                            </VBox>


                            <Region HBox.hgrow="ALWAYS" />


                            <VBox alignment="CENTER_RIGHT"
                                  spacing="2">

                                <Label styleClass="stat-label"
                                       text="VENDAS PENDENTES" />

                                <Label fx:id="lblPendentes"
                                       style="-fx-font-size:22px;
                                              -fx-font-weight:bold;
                                              -fx-text-fill:#C2410C;"
                                       text="0" />

                            </VBox>

                        </HBox>


                        <!-- ================= PAINÉIS INFERIORES ================= -->

                        <HBox spacing="18">


                            <!-- ÚLTIMAS VENDAS -->

                            <VBox spacing="12"
                                  styleClass="dashboard-section"
                                  HBox.hgrow="ALWAYS">

                                <Label styleClass="dashboard-section-title"
                                       text="Últimas vendas" />

                                <VBox fx:id="boxUltimasVendas"
                                      spacing="4">

                                    <Label styleClass="dashboard-empty"
                                           text="Nenhuma venda encontrada." />

                                </VBox>

                            </VBox>


                            <!-- ESTOQUE BAIXO -->

                            <VBox spacing="12"
                                  styleClass="dashboard-section"
                                  HBox.hgrow="ALWAYS">

                                <Label styleClass="dashboard-section-title"
                                       text="Produtos com estoque baixo" />

                                <VBox fx:id="boxEstoqueBaixo"
                                      spacing="4">

                                    <Label styleClass="dashboard-empty"
                                           text="Nenhum produto com estoque baixo." />

                                </VBox>

                            </VBox>

                        </HBox>


                        <Region VBox.vgrow="ALWAYS" />


                        <!-- ================= RODAPÉ ================= -->

                        <Label styleClass="app-header-sub"
                               style="-fx-text-fill:#9CA3AF;"
                               text="Salamandra Incensária · versão 2.2.1" />

                    </VBox>

                </StackPane>

            </center>

        </BorderPane>

    </children>

</AnchorPane>